# Copy to .env (git-ignored) and fill in. The Makefile loads .env for every target.

# Postgres. Demo/dev data lives here; `make seed` and `make year` write to it.
DATABASE_URL=postgresql://tpa:tpa@localhost:5433/tpa
# `make test` resets this one, never DATABASE_URL. `make db-scratch` creates it.
TEST_DATABASE_URL=postgresql://tpa:tpa@localhost:5433/tpa_scratch

# Claude (console.anthropic.com → API keys). Only needed with TPA_USE_MODEL=1:
# the model-played humans and escalation-card drafting. Everything runs without it.
ANTHROPIC_API_KEY=
TPA_USE_MODEL=0
# TPA_MODEL=claude-opus-5-5

# Who answers the cards when the API steps a month: inbox (people, in the UI), players
# (the model-played humans) or autopilot (last year's answers, no judgment engine).
TPA_HUMANS=inbox
# Allow POST /api/reset to re-seed the database (destroys it).
TPA_ALLOW_RESET=0
