<mxfile host="drawio"><diagram id="jade" name="JADE architecture"><mxGraphModel dx="1600" dy="720" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="790" background="#fbf7f2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b style='font-size:30px;color:#5b241d'&gt;How JADE closes the trade promotion books&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#292623;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;span style='font-size:15px;color:#72726b'&gt;One month of close, in the order the business runs it. Every number from deterministic code; a person only where the agreement can't decide.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#292623;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="26" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:13px;color:#b64f2f;letter-spacing:1px'&gt;SOURCES&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#292623;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="24" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;SEC EDGAR · 10-K&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#72726b'&gt;General Mills: net sales, $493M trade liability, Walmart 22% of sales&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#ffffff;strokeColor=#d7c2b5;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="300" height="92" as="geometry"/></mxCell><mxCell id="c15" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="50" y="146" width="50" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Agreements &amp;amp; amendments&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#72726b'&gt;Trade programs as documents (TP-0214, AM-02)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#ffffff;strokeColor=#d7c2b5;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="300" height="80" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="52" y="248" width="56" height="33" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Shipments, invoices, returns&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#72726b'&gt;ERP-shaped, landing on their own dates&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#ffffff;strokeColor=#d7c2b5;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="40" y="332" width="300" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;span style='font-size:30px'&gt;🚚&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#292623;" vertex="1" parent="1"><mxGeometry x="54" y="352" width="50" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Deductions inbox&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#72726b'&gt;Notices, backup, forwarded amendments, by email&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#ffffff;strokeColor=#d7c2b5;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="40" y="428" width="300" height="100" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="46" y="434" width="54" height="30" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="46" y="464" width="54" height="30" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="46" y="494" width="54" height="30" as="geometry"/></mxCell><mxCell id="c24" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="300" y="436" width="28" height="28" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style='font-size:13px;color:#b64f2f;letter-spacing:1px'&gt;THE MONTHLY CLOSE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#292623;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="1160" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;① Read terms&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Clauses become program terms, each citing its source&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#fff4ec;strokeColor=#ff7c38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="128" width="210" height="112" as="geometry"/></mxCell><mxCell id="c27" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="574" y="134" width="26" height="26" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;② Accrue on shipment&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Dr 4100 contra-revenue&lt;br&gt;Cr 2300 accrued liability&lt;br&gt;(ASC 606)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#fff4ec;strokeColor=#ff7c38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="128" width="210" height="112" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;③ Match deductions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;customer · program · period · rate · backup&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#fff4ec;strokeColor=#ff7c38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="128" width="210" height="112" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;④ Judgment engine&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Precedent hit → clear or dispute silently&lt;br&gt;Miss → escalate to a named person · SoD throws&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#fff4ec;strokeColor=#ff7c38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="128" width="440" height="112" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;People&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;controller · customer team · analysts&lt;br&gt;&quot;Which is the source&lt;br&gt;of truth?&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#f7ece6;strokeColor=#5b241d;" vertex="1" parent="1"><mxGeometry x="1350" y="290" width="210" height="92" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Precedent store&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Answered once, applied silently after&lt;br&gt;37 of 40 repeats&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#f7ece6;strokeColor=#5b241d;" vertex="1" parent="1"><mxGeometry x="1120" y="290" width="210" height="92" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;⑤ Close &amp;amp; verification gates&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Debits = credits · cleared ≤ accrued · claims in window · no stale accruals&lt;br&gt;A failure blocks the period&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#fff4ec;strokeColor=#ff7c38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="470" width="440" height="108" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;⑥ Restate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Amendment lands late → six closed months corrected, then and now kept&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#fff4ec;strokeColor=#ff7c38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="470" width="210" height="108" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;⑦ Sign-off &amp;amp; audit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Excel-checkable CSVs · ask it why it did anything&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#fff4ec;strokeColor=#ff7c38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="470" width="210" height="108" as="geometry"/></mxCell><mxCell id="c36" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="812" y="476" width="30" height="28" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Analytical review&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Liability vs. General Mills' reported ratio, every close&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#ffffff;strokeColor=#d7c2b5;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="210" height="108" as="geometry"/></mxCell><mxCell id="c38" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="406" y="476" width="26" height="26" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b241d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5b241d;labelBackgroundColor=#fbf7f2;" edge="1" parent="1" source="c16" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b241d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5b241d;labelBackgroundColor=#fbf7f2;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="c18" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b241d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5b241d;labelBackgroundColor=#fbf7f2;exitX=1;exitY=0.25;entryX=0.5;entryY=1;" edge="1" parent="1" source