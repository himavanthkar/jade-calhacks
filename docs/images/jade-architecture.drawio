le=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b241d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5b241d;labelBackgroundColor=#fbf7f2;exitX=0.5;exitY=0;entryX=0.24;entryY=1;dashed=1;" edge="1" parent="1" source="c32" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c48" value="hit / decided" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b241d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5b241d;labelBackgroundColor=#fbf7f2;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c30" target="c33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="184"/><mxPoint x="1600" y="524"/></Array></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b241d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5b241d;labelBackgroundColor=#fbf7f2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b241d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5b241d;labelBackgroundColor=#fbf7f2;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b241d;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5b241d;labelBackgroundColor=#fbf7f2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c35" target="c37"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c52" value="&lt;b style='font-size:13px;color:#b64f2f;letter-spacing:1px'&gt;PROOF HARNESS &amp;amp; PLATFORM&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#292623;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1520" height="24" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Proof harness (evals)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Deterministic seed · 50 planted errors · answer key&lt;br&gt;Precision 100% · recall 100% · unseen seeds 42 &amp;amp; 2024&lt;br&gt;Real-data backtest: 16 years of General Mills 10-Ks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;fillColor=#eef5f0;strokeColor=#21654a;" vertex="1" parent="1"><mxGeometry x="40" y="638" width="520" height="96" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Insert-only bitemporal ledger&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;One write path; corrections are reversals, never edits&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="590" y="638" width="300" height="96" as="geometry"/></mxCell><mxCell id="c55" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="602" y="660" width="48" height="48" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Engine &amp;amp; API&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Python · FastAPI · every number by code&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;align=left;spacingLeft=96;" vertex="1" parent="1"><mxGeometry x="920" y="638" width="300" height="96" as="geometry"/></mxCell><mxCell id="c57" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="932" y="666" width="38" height="38" as="geometry"/></mxCell><mxCell id="c58" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="976" y="666" width="38" height="38" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Claude + React surface&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Claude reads &amp;amp; drafts; never computes, never approves&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#d7c2b5;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;fontColor=#292623;align=center;verticalAlign=middle;spacing=8;align=left;spacingLeft=96;" vertex="1" parent="1"><mxGeometry x="1250" y="638" width="310" height="96" as="geometry"/></mxCell><mxCell id="c60" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1262" y="666" width="38" height="38" as="geometry"/></mxCell><mxCell id="c61" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1306" y="666" width="38" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>