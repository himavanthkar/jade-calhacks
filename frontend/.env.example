# Copy to .env.local, then restart the dev server.
VITE_API_MODE=mock
# Mock only: inbox (step Jan–Feb, answer cards) or moment (month 8 after the restatement).
VITE_MOCK_SCENARIO=inbox
VITE_API_BASE_URL=/api
# Development proxy target (not exposed as a VITE variable).
API_PROXY_TARGET=http://127.0.0.1:8000
